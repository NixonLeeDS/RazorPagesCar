@page "{id:int?}"
@model RazorPagesCar.Pages.Cars.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Car</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Car.carName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Car.carName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Car.ManufactureDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Car.ManufactureDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Car.Type)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Car.Type)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Car.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Car.Price)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Car.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a> |

    <a asp-page="./checkout">Rent</a>
</div>
